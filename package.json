{
  "name": "pages-analytics",
  "version": "0.3.0",
  "description": "Inject an analytics snippet into your built static site at deploy time, using an ID from your CI environment instead of your source code.",
  "keywords": [
    "analytics",
    "github-pages",
    "google-analytics",
    "plausible",
    "static-site",
    "postbuild",
    "ci"
  ],
  "license": "MIT",
  "author": "Javis Pérez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javisperez/pages-analytics.git"
  },
  "homepage": "https://github.com/javisperez/pages-analytics#readme",
  "bugs": {
    "url": "https://github.com/javisperez/pages-analytics/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "bin": {
    "pages-analytics": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./track": {
      "types": "./dist/track.d.ts",
      "default": "./dist/track.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
